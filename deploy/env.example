# Ricochet Server environment
#
# Installed by the package at /etc/ricochet/env, owned root:ricochet, mode 640.
# run.sh sources this file and exports the password to the server through the
# RICOCHET_PG_PASSWORD environment variable, so it never appears on the
# command line.

# PostgreSQL database password (required)
DB_PASSWORD=change_me

# Public IP address of this server (required for peer discovery).
# Without it, Identify only reports the host's private addresses and remote
# clients lose the server's address after the first exchange.
# Use the address clients reach this host on, e.g. EXTERNAL_IP=203.0.113.10
# Every listen address is advertised on it, for every transport config.yaml
# enables (server.transports), so it needs no port or protocol.
EXTERNAL_IP=

# Optional overrides
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ricochet
# DB_USER=ricochet
# TLS to PostgreSQL is required by default. Set to "disable" only when the
# database is on the same host or a private network you trust.
# DB_SSLMODE=require
# LISTEN_PORT moves every listen address to this one port. A server running
# UDX beside quic-v1 or webtransport needs two UDP ports: set them in
# config.yaml listen_addresses and leave LISTEN_PORT unset.
# LISTEN_PORT=55223
