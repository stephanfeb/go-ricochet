# Ricochet Server Environment Variables
# Copy this file to /etc/ricochet/env and set appropriate values

# PostgreSQL database password (required)
DB_PASSWORD=your_secure_password_here

# Optional: Override other config values
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ricochet
# DB_USER=ricochet
# DB_SSLMODE=disable
