# Ricochet Server Environment Variables
# Copy this file to /etc/ricochet/env and set appropriate values

# PostgreSQL database password (required)
DB_PASSWORD=your_secure_password_here

# Public IP address of this server (required for proper peer discovery)
# Without this, remote clients lose the server's address after Identify
# because only private IPs are reported.
EXTERNAL_IP=152.42.240.103

# Optional: Override other config values
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ricochet
# DB_USER=ricochet
# DB_SSLMODE=disable
# LISTEN_PORT=55223
