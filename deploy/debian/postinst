#!/bin/bash
set -e

# Create ricochet user if it doesn't exist
if ! id -u ricochet >/dev/null 2>&1; then
    useradd -r -s /bin/false -d /var/lib/ricochet -c "Ricochet Server" ricochet
    echo "Created ricochet system user"
fi

# Create and set permissions on directories
mkdir -p /var/lib/ricochet
mkdir -p /var/log/ricochet
chown -R ricochet:ricochet /var/lib/ricochet
chown -R ricochet:ricochet /var/log/ricochet
chmod 750 /var/lib/ricochet /var/log/ricochet

# Ensure config file has correct permissions
if [ -f /etc/ricochet/config.yaml ]; then
    chown root:ricochet /etc/ricochet/config.yaml
    chmod 640 /etc/ricochet/config.yaml
fi

# The env file holds the database password. Create it from the example on
# first install so it exists with safe permissions before anyone edits it,
# and tighten the permissions on every upgrade in case they were loosened.
if [ ! -f /etc/ricochet/env ]; then
    cp /etc/ricochet/env.example /etc/ricochet/env
fi
chown root:ricochet /etc/ricochet/env
chmod 640 /etc/ricochet/env

# Ensure config directory has correct permissions
chown root:ricochet /etc/ricochet
chmod 750 /etc/ricochet

# Reload supervisor to pick up new config
if systemctl is-active --quiet supervisor; then
    supervisorctl reread 2>/dev/null || true
    supervisorctl update 2>/dev/null || true
    echo "Supervisor configuration updated"
fi

echo ""
echo "============================================"
echo "Ricochet Server Installation Complete"
echo "============================================"
echo ""
echo "Next steps:"
echo "  1. Edit /etc/ricochet/env: set DB_PASSWORD and EXTERNAL_IP"
echo "  2. Initialize database: psql -U ricochet -d ricochet -f /opt/ricochet/schema.sql"
echo "  3. Start service: sudo supervisorctl start ricochet"
echo ""
echo "View logs with: sudo supervisorctl tail -f ricochet"
echo ""
