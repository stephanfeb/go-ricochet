#!/bin/bash
set -e

echo "Stopping Ricochet server..."

# Stop the service before the files change. On an upgrade, remember that it
# was running so postinst can start the new binary: supervisorctl update
# only restarts programs whose supervisor config changed, and a stopped
# program stays stopped, so without this an upgrade left the server down.
MARKER=/var/lib/ricochet/.restart-after-upgrade
if command -v supervisorctl >/dev/null 2>&1; then
    if [ "$1" = "upgrade" ] && supervisorctl status ricochet 2>/dev/null | grep -q RUNNING; then
        touch "$MARKER"
    fi
    supervisorctl stop ricochet 2>/dev/null || true
    echo "Ricochet server stopped"
fi
